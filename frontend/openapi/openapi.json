{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "App_getHello",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["App"]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "healthLiveness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The application process is alive.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseDto"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/LivenessResponseDto"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "The requested resource was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected server error occurred.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Check whether the process is alive",
        "tags": ["Health"]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "healthReadiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The application and database are ready.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseDto"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/ReadinessResponseDto"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "The requested resource was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected server error occurred.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Check whether the application can serve traffic",
        "tags": ["Health"]
      }
    }
  },
  "info": {
    "title": "Pomodoro and Music API",
    "description": "Backend API for Pomodoro sessions and music playback.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ApiErrorDetailDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "name"
          },
          "message": {
            "type": "string",
            "example": "Name is required"
          }
        },
        "required": ["message"]
      },
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "example": 400
          },
          "message": {
            "type": "string",
            "example": "Invalid request"
          },
          "error_code": {
            "type": "string",
            "example": "INVALID_INPUT"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiErrorDetailDto"
            }
          },
          "request_id": {
            "type": "string",
            "example": "0198bb70-92ac-77c8-b22f-892d2d97f599"
          }
        },
        "required": ["code", "message", "error_code", "details", "request_id"]
      },
      "ApiResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "object",
            "example": "success"
          },
          "code": {
            "type": "number",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "Success"
          },
          "data": {
            "type": "object"
          }
        },
        "required": ["status", "code", "message", "data"]
      },
      "LivenessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": ["status"]
      },
      "ReadinessChecksDto": {
        "type": "object",
        "properties": {
          "application": {
            "type": "string",
            "example": "up"
          },
          "database": {
            "type": "string",
            "example": "up"
          }
        },
        "required": ["application", "database"]
      },
      "ReadinessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ready"
          },
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecksDto"
          }
        },
        "required": ["status", "checks"]
      }
    }
  }
}
